AUTONOMA_API_HOST=0.0.0.0
AUTONOMA_API_PORT=8080
AUTONOMA_POSTGRES_PORT=5432
AUTONOMA_REDIS_PORT=6379
AUTONOMA_DATABASE_URL=postgres://autonoma:autonoma@localhost:5432/autonoma?sslmode=disable
AUTONOMA_REDIS_ADDR=localhost:6379

# AI runtime reads exported environment variable; mock is the safe default.
AUTONOMA_LLM_PROVIDER=mock
# Ollama example: change provider to openai_compatible and export those settings.
# AUTONOMA_LLM_BASE_URL=http://localhost:11434/v1
# AUTONOMA_LLM_MODEL=llama3.2
# AUTONOMA_LLM_TIMEOUT_SECONDS=60
# API key is optional for Ollama; supply hosted credentials from your environment.
# AUTONOMA_LLM_INPUT_USD_PER_MILLION_TOKEN=0
# AUTONOMA_LLM_OUTPUT_USD_PER_MILLION_TOKEN=0